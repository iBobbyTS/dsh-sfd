{
  "name": "@ibobbyts/dsh-sfd",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2"
  },
  "description": "Thin SFD graph compiler and editable-progress external-subagent wrapper for DSH.",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "lib/compiler.js",
    "lib/es-cli.js",
    "lib/execution.js",
    "lib/guidance.js",
    "lib/graph-store.js",
    "lib/scoped-host.js",
    "lib/session-store.js",
    "lib/skill-provider.js",
    "lib/workflow-tools.js",
    "skills/",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "scripts/verify-skill-snapshot.js",
    "DESIGN.md",
    "REQUIREMENTS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-scope": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "^0.2.1-rc.2"
  },
  "scripts": {
    "test": "node --test test/current/*.test.js",
    "verify:skills": "node scripts/verify-skill-snapshot.js"
  }
}
